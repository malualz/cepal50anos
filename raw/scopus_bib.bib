	affiliations = {Universidad del Pacífico, Lima, Peru; Universidad del Pacífico, Department of Economics, Lima, Peru},
	abstract = {This study seeks to determine whether access to a larger volume of funds from the mining canon affects the level of capital spending by district mayors in election years. The effect of Peru’s electoral cycles on district public investment (from 2002 to 2011), and how this relates to the mining canon, is analysed in terms of the budget political cycle, using a fixed-effects panel model. The results show that the mining canon has a differential effect in the 20% of districts that receive the largest amounts; but, in general, there is no clear cyclicality between capital expenditure in these municipalities and election years. © 2021 Elsevier B.V., All rights reserved.},
