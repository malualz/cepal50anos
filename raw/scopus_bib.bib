@ARTICLE{de Araujo201734,
	author = {de Araujo, Jair Andrade and Marinho, Emerson Luís Lemos and Campêlo, Guaracyane Lima},
	title = {Economic growth and income concentration and their effects on poverty in Brazil},
	year = {2017},
	journal = {CEPAL Review},
	number = {123},
	pages = {34 - 53},
	doi = {10.18356/F61073EF-EN},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112272886&doi=10.18356%2FF61073EF-EN&partnerID=40&md5=d1eca2395af2162ce4ee2e08e86cb5b5},
	affiliations = {Universidade Federal do Ceará, Department of Agricultural Economics, Fortaleza, Brazil; Universidade Federal do Ceará, Fortaleza, Brazil; Universidade Federal do Ceará, Department of Economics and Finance, Fortaleza, Brazil},
	abstract = {We use panel data for Brazilian states from 1995 to 2009 to analyse the impact of economic growth and income inequality on poverty change in Brazil, seeking to evaluate the Bourguignon (2003) hypothesis that the more unequal a country is, the less effective economic growth will be at reducing poverty. To this end, we estimate poverty elasticities relative to income and inequality, specifying two dynamic econometric models estimated via the generalized method of moments (GMM) system developed by Arellano and Bond (1991), Arellano and Bover (1995) and Blundell and Bond (1998). The model-estimated results prompt the conclusion that the income growth effect on poverty reduction is smaller when the initial development level is low. The same is found when the initial inequality level is high. Therefore, regions with a low initial development level, high initial inequality or both present less favourable conditions for reducing poverty through income growth. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Brazil; Econometric Models; Economic Growth; Income Distribution; Poverty; Poverty Mitigation},
	publisher = {United Nations Publications},
	issn = {02512920; 16840348},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Cano201757,
	author = {Cano, Liliana},
	title = {Personal income tax and income inequality in ecuador between 2007 and 2011},
	year = {2017},
	journal = {CEPAL Review},
	number = {123},
	pages = {57 - 75},
	doi = {10.18356/F31C2017-EN},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85095614594&doi=10.18356%2FF31C2017-EN&partnerID=40&md5=b468057e45c943b4cbfb20f716a2322a},
	affiliations = {Laboratoire d’Etude et de Recherche sur l’Economie, les Politiques et les Systèmes sociaux (LEREPS), Research Laboratory on Economics, Toulouse, France},
	abstract = {This paper uses data from individual income tax returns to explore the redistributive effect of personal income tax in Ecuador between 2007 and 2011. Following common practice in tax incidence analysis, we first compute indices of income tax progressivity and redistributive impact. We then mobilize microsimulation techniques to simulate the redistributive effect of personal income tax under different taxable income scenarios. Finally, we calculate the effective tax rates paid by top income groups and derive a range of optimal income taxes for the top 1% income group. We obtain two main empirical results. First, although Ecuador’s personal income tax is highly progressive, its redistributive capacity is low: our findings show that high-income individuals are more likely to reduce their taxable income through legal tax deductions than low-income individuals. Second, while the effective tax rates paid by high-income individuals are relatively low, optimal tax rates could be as high as 63%. © 2021 Elsevier B.V., All rights reserved.},
	publisher = {United Nations Publications},
	issn = {02512920; 16840348},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

