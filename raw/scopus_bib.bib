@ARTICLE{Vieira-Filho2016203,
	author = {Vieira-Filho, José Eustáquio Ribeiro and Fornazier, Armando},
	title = {Agricultural productivity: Closing the gap between Brazil and the United States; Productividad agropecuaria: Reducción de la brecha productiva entre el Brasil y los Estados Unidos de América},
	year = {2016},
	journal = {CEPAL Review},
	volume = {2016},
