@article{ WOS:000674523800001,
Author = {Vergara, Sebastian},
Title = {The role of productive and technological capacities in the dynamics of
   exports of developing countries},
Journal = {CEPAL REVIEW},
Year = {2021},
Number = {133},
Pages = {7-32},
Month = {APR},
Abstract = {Productive and technological capabilities are important drivers of
   exports. This paper investigates, from an empirical approach, their role
   in the microeconomic dynamics of exports of 40 developing countries. The
   analysis shows that, within different economic sectors, countries with
   higher productive capacities have more and larger exporters, who also
   charge higher prices for their products. The results also confirm a
   positive relationship between technological capabilities and
   diversification: within each sector, exporters from countries with
   higher capabilities tend to export more products and to more destination
   markets. Finally, technological capabilities are positively associated
   with diversification at the level of products and trade destinations in
   high-tech sectors.},
Publisher = {COMISION ECONOMICA PARA AMERICA LATINA Y EL CARIBE},
