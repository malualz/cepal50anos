@article{ WOS:001417169600003,
Author = {Nassif, Andre},
Title = {The centre-periphery model and the political economy of the Economic
   Commission for Latin America and the Caribbean (ECLAC): yesterday and
   today},
Journal = {CEPAL REVIEW},
Year = {2024},
Number = {144},
Pages = {17-37},
Month = {DEC},
Abstract = {This article focuses on the hypotheses of Prebisch and Singer on the
   core-periphery model, which has been the core of the theory of
   development of peripheral countries. The article emphasizes the
   theoretical and normative aspects related to the political economy of
   the Economic Commission for Latin America and the Caribbean (ECLAC) from
   the early 1950s to the present. It shows that, from the 1980s onwards,
   ECLAC economists, influenced by neo-Schumpeterian evolutionary models
   and equipped with sophisticated microeconomic instruments, kept intact
   Prebisch's original proposals regarding external constraints on the
   economic development of peripheral countries, while also making a
