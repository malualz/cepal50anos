@article{ WOS:001417169600005,
Author = {Artica, Rodrigo Perez and Rabinovich, Joel},
Title = {What factors drive capital outflows from the non-financial private
   sector in Latin America?},
Journal = {CEPAL REVIEW},
Year = {2024},
Number = {144},
Pages = {57-80},
Month = {DEC},
Abstract = {This paper analyses gross capital outflows by the non-financial private
   sector of six large Latin American economies over the past three
   decades. While there has been considerable recent attention to corporate
   capital inflows in emerging markets, the accumulation of external assets
   by the non-financial private sector in these countries has been omitted.
   This omission is surprising, given that resident outflows contribute
   significantly to the financial account balance and external financial
   vulnerability of the region. Moreover, while there are important
   differences across countries, these outflows were generally found to be:
   (i) highly correlated with the global financial cycle, (ii) positively
   related to capital inflows and the current account balance, meaning that
   they grow with increased availability of foreign exchange, and (iii)
   apparently unaffected by changes in the riskiness of domestic assets.},
