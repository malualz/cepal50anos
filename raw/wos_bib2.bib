@article{ WOS:000748607700005,
Author = {D'Amato, Stefan Wilson and de Carvalho, Luciano Dias},
Title = {Exchange regimes, structural change and capital mobility in a developing
   economy},
Journal = {CEPAL REVIEW},
Year = {2021},
Number = {135},
Pages = {113-127},
Month = {DEC},
Abstract = {This paper proposes to develop a balance of payments constrained growth
   model with the objective of analyzing the importance of the relationship
   between real exchange rate misalignment and the share of industry in
   output. Building on the work of Gabriel, Jayme and Oreiro (2016) we
   extend the model in order to address: i) the influence of price
   competitiveness on net exports; ii) capital mobility; iii) nominal
   exchange rate flexibility; iv) the nominal wage as a fraction of the
   value of labor productivity; and v) a quadratic relationship between the
   growth rate of industry's share of output and exchange rate
   misalignment. An important result is that both flexible and fixed
   exchange rate regimes are compatible with a balanced growth path.},
Publisher = {COMISION ECONOMICA PARA AMERICA LATINA Y EL CARIBE},
