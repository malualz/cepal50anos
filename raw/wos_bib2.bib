@article{ WOS:001375817500010,
Author = {de Almeida, Karina Palmieri and dos Reis Azevedo Botelho, Marisa},
Title = {Evolution of support for technological innovation in the Brazilian
   machinery and equipment sector since the 2000s: analysis based on the
   Innovation Survey (PINTEC)},
Journal = {CEPAL REVIEW},
Year = {2024},
Number = {143},
Pages = {203-226},
Month = {AUG},
Abstract = {This article analyses the evolution of technological innovation in the
   machinery and equipment sector in Brazil and compares the evolution of
   innovative activities of companies in the sector that benefited from
   government support programmes for innovation versus those that did not
   benefit from them. Available data from six editions of the Innovation
   Survey (PINTEC) and from a special tabulation prepared by the Brazilian
   Institute of Geography and Statistics (IBGE) were used. The results
   indicate that industrial and science, technology and innovation (STI)
   policies of the 2000s had positive effects on the sector analysed:
   innovative activities of companies were boosted by government support
   instruments and evolved favourably compared to those that did not
   benefit from such support. The systematized data also allow us to detect
   some deficiencies in the support programmes for the sector.},
